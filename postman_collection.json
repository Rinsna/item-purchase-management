          }
        },
        {
          "name": "Delete Item Type",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/item-types/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "item-types", "1"]
            },
            "description": "Deletes item type or deactivates it if items exist under it."
          }
        }
      ]
    },
